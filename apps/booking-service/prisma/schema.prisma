generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/booking-prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDING
  REFUNDED
}

model Booking {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // IDs owned by other services. No cross-service database foreign keys.
  userId    String
  eventId   String
  sessionId String

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  recipientFullName String?
  recipientEmail    String?

  subtotal       Float
  discountAmount Float      @default(0)
  feeAmount      Float      @default(0)
  totalAmount    Float
  currency       String  @default("USD")

  paymentId String?
  expiresAt DateTime?

  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?
  expiredAt         DateTime?
  paidAt            DateTime?
  paymentFailedAt   DateTime?
  refundedAt        DateTime?

  confirmationAttempts         Int       @default(0)
  nextConfirmationAttemptAt    DateTime?
  confirmationLastError        String?
  inventoryCompensationPending Boolean?  @default(false)
  inventoryReleasedAt          DateTime?
  nextCompensationAttemptAt    DateTime?

  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items BookingItem[]

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([sessionId, status])
  @@index([status, expiresAt])
  @@index([status, paymentStatus, nextConfirmationAttemptAt])
  @@index([status, inventoryCompensationPending, nextCompensationAttemptAt])
  @@index([paymentStatus, createdAt])
  @@index([paymentStatus, confirmedAt])
  @@map("bookings")
}

model BookingItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bookingId    String   @db.ObjectId
  ticketTypeId String

  ticketTypeName String
  ticketTypeCode String

  quantity  Int
  unitPrice Float
  // Exact amount in currency minor units; nullable only for legacy bookings.
  unitPriceMinor Int?
  subtotal  Float

  reservationId String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, ticketTypeId])
  @@index([ticketTypeId])
  @@index([reservationId])
  @@map("booking_items")
}

// Outbox cho booking.confirmed — ticket-service nghe event này để cấp vé.
// Ghi trong cùng tx với transition CONFIRMED nên không thể mất event.
model OutboxEvent {
  // Dùng làm message ID để consumer chống xử lý trùng.
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Booking id (hex string, không phải ObjectId).
  aggregateId String

  eventType String

  aggregateVersion Int
  schemaVersion    Int @default(1)

  payload Json

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?

  @@index([publishedAt, nextAttemptAt, createdAt])
  @@index([aggregateId, aggregateVersion])
  @@map("outbox_events")
}

// Projection eventId → organizerId từ event.published — phục vụ
// ownership check local cho các query đọc booking của organizer,
// không cần gọi sync sang event-service.
model EventCatalog {
  eventId     String @id @map("_id")
  organizerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_catalogs")
}
