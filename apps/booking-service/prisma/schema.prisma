generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/booking-prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDING
  REFUNDED
}

model Booking {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // IDs owned by other services. No cross-service database foreign keys.
  userId    String
  eventId   String
  sessionId String

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  subtotal       Float
  discountAmount Float      @default(0)
  feeAmount      Float      @default(0)
  totalAmount    Float
  currency       String  @default("USD")

  paymentId String?
  expiresAt DateTime?

  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?
  expiredAt         DateTime?
  paidAt            DateTime?
  paymentFailedAt   DateTime?
  refundedAt        DateTime?

  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items BookingItem[]

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([sessionId, status])
  @@index([status, expiresAt])
  @@index([paymentStatus, createdAt])
  @@map("bookings")
}

model BookingItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bookingId    String   @db.ObjectId
  ticketTypeId String

  ticketTypeName String
  ticketTypeCode String

  quantity  Int
  unitPrice Float
  subtotal  Float

  reservationId String?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, ticketTypeId])
  @@index([ticketTypeId])
  @@index([reservationId])
  @@map("booking_items")
}

// Projection eventId → organizerId từ event.published — phục vụ
// ownership check local cho các query đọc booking của organizer,
// không cần gọi sync sang event-service.
model EventCatalog {
  eventId     String @id @map("_id")
  organizerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_catalogs")
}
