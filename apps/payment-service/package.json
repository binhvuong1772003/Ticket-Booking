{
  "name": "@ticket-booking/payment-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../.. build:payment",
    "start": "bun run --cwd ../.. start:payment",
    "start:dev": "bun run --cwd ../.. start:payment",
    "start:prod": "bun run --cwd ../.. start:payment:prod",
    "prisma:generate": "bunx prisma generate --schema src/prisma/schema.prisma",
    "prisma:push": "bunx prisma db push --schema src/prisma/schema.prisma"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "6.19.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
