generator client {
  provider = "prisma-client-js"
  output   = "../generated/payment-prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  CREATED
  SUCCEEDED
  EXPIRED
  FAILED
  REFUNDED
}

model Payment {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId

  bookingId          String
  // UUID từ auth-service — ai trả tiền (để event refund mang user_id).
  userId             String?
  checkoutSessionId  String?       @unique
  // Không @unique: Mongo unique index coi null là 1 giá trị → chỉ cho 1 payment
  // chưa có intent/refund. Stripe đã đảm bảo 1 intent ↔ 1 checkout session.
  paymentIntentId    String?
  stripeRefundId     String?
  organizerAccountId String?

  // Đơn vị nhỏ nhất của currency (xu/cent)
  amount             Int
  currency           String
  status             PaymentStatus @default(CREATED)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  succeededAt        DateTime?
  refundedAt         DateTime?
  // Intent refund: ghi trước khi gọi Stripe — worker/backstop đọc field này.
  refundRequestedAt  DateTime?

  @@index([bookingId])
  @@index([paymentIntentId])
  @@index([stripeRefundId])
  @@index([status, createdAt])
  @@index([status, refundRequestedAt])
  @@map("payments")
}

model PaymentOutbox {
  // Message ID để consumer chống xử lý trùng
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  // Stripe event.id — dedup key: Stripe retry cùng event chỉ ghi 1 lần
  stripeEventId String   @unique

  // Kafka topic: payment.succeeded, payment.expired, payment.failed
  eventType     String

  payload       Json

  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?

  @@index([publishedAt, nextAttemptAt, createdAt])
  @@map("payment_outbox")
}
