{
  "name": "ticket-booking",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun run build:gateway && bun run build:auth && bun run build:booking && bun run build:event && bun run build:inventory && bun run build:notification && bun run build:payment",
    "build:notification": "nest build notification-service",
    "build:gateway": "nest build api-gateway",
    "build:auth": "nest build auth-service",
    "build:booking": "nest build booking-service",
    "build:event": "nest build event-service",
    "build:inventory": "nest build inventory-service",
    "build:payment": "nest build payment-service",
    "prisma:generate:inventory": "bun run --cwd apps/inventory-service prisma:generate",
    "prisma:push:inventory": "bun run --cwd apps/inventory-service prisma:push",
    "prisma:generate:booking": "bun run --cwd apps/booking-service prisma:generate",
    "prisma:push:booking": "bun run --cwd apps/booking-service prisma:push",
    "prisma:generate:payment": "bun run --cwd apps/payment-service prisma:generate",
    "prisma:push:payment": "bun run --cwd apps/payment-service prisma:push",
    "prisma:generate:auth": "node scripts/prisma-auth.cjs generate --schema apps/auth-service/prisma/schema.prisma",
    "prisma:push:auth": "node scripts/prisma-auth.cjs db push --schema apps/auth-service/prisma/schema.prisma",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch --env-file apps/auth-service/.env",
    "start:booking": "nest start booking-service --watch --env-file apps/booking-service/.env",
    "start:event": "nest start event-service --watch --env-file apps/event-service/.env",
    "start:inventory": "nest start inventory-service --watch --env-file apps/inventory-service/.env",
    "start:notification": "nest start notification-service --watch --env-file apps/notification-service/.env",
    "start:payment": "nest start payment-service --watch --env-file apps/payment-service/.env",
    "start:all": "docker compose up -d --build",
    "start:all:dev": "concurrently -n gateway,auth,booking,event,inventory,notification,payment -c auto \"bun run start:gateway\" \"bun run start:auth\" \"bun run start:booking\" \"bun run start:event\" \"bun run start:inventory\" \"bun run start:notification\" \"bun run start:payment\"",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main.js",
    "start:auth:prod": "node dist/apps/auth-service/main.js",
    "start:booking:prod": "node dist/apps/booking-service/main.js",
    "start:event:prod": "node dist/apps/event-service/main.js",
    "start:inventory:prod": "node dist/apps/inventory-service/main.js",
    "start:notification:prod": "node dist/apps/notification-service/src/main.js",
    "start:payment:prod": "node dist/apps/payment-service/main.js",
    "lint": "oxlint apps/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "viapps/ticket-booking/test run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.6",
    "ioredis": "^6.0.0",
    "kafka": "^0.2.3",
    "kafkajs": "^2.2.4",
    "nodemailer": "^10.0.10",
    "prisma": "6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "spectaql": "^3.0.9",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
